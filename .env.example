# Application
APP_ENV=development
APP_PORT=3001
CORS_ORIGIN=http://localhost:3000,http://localhost:3002

# Database
DATABASE_URL=postgresql://postgres:postgres@localhost:5433/klab_booking

# JWT
JWT_SECRET=change-me-to-a-long-random-secret-at-least-16-chars
JWT_EXPIRES_IN=7d

# Booking rules
# Hours before a schedule's start_time within which a cancellation still refunds credit.
BOOKING_CANCELLATION_WINDOW_HOURS=12

# DOKU Checkout
DOKU_ENV=sandbox
DOKU_CLIENT_ID=
DOKU_SECRET_KEY=
DOKU_MERCHANT_ID=
DOKU_CHECKOUT_SANDBOX_URL=https://api-sandbox.doku.com/checkout/v1/payment
DOKU_CHECKOUT_PRODUCTION_URL=https://api.doku.com/checkout/v1/payment
DOKU_CALLBACK_URL=http://localhost:3001/payments/doku/callback
DOKU_RETURN_URL=http://localhost:3002/checkout/result
# Local-only switch to bypass the real DOKU network call for testing. Must stay false in staging/production.
DOKU_MOCK=false
# Local-only: emit temporary masked debug logs for the outbound checkout request. Must stay false in staging/production.
DOKU_DEBUG_LOGGING=false

# Soft launch (participant-code-gated booking window)
# When enabled, in-window classes booked during the window are exclusive to allocated participants
# (no credit required/debited). Dates are ISO-8601 with explicit offset; END is inclusive.
SOFT_LAUNCH_ENABLED=false
SOFT_LAUNCH_START=2026-09-20T00:00:00+07:00
SOFT_LAUNCH_END=2026-09-25T23:59:59+07:00
SOFT_LAUNCH_QUOTA=80
